// ============================================================
// AUTHENTICATION MODELS (Auth.js Compatible)
// ============================================================

model User {
  id                String     @id @default(cuid()) @db.VarChar(50)
  name              String?
  email             String     @unique @db.VarChar(50)
  emailVerified     DateTime?
  passwordHash      String?
  phone             String?
  image             String?
  status            UserStatus @default(PENDING_VERIFICATION)
  preferredLanguage String     @default("en")
  preferredTheme    Appearance @default(SYSTEM)
  twoFactorEnabled  Boolean    @default(false)
  lastLoginAt       DateTime?
  loginAttempts     Int        @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  accounts                   Account[]
  sessions                   Session[]
  memberships                UserSellerMembership[]
  userRoles                  UserRole[]
  notifications              Notification[]
  auditLogs                  AuditLog[]                 @relation("AuditUser")
  passwordResetTokens        PasswordResetToken[]
  twoFactorToken             TwoFactorToken?
  loginHistory               LoginHistory[]
  createdProducts            Product[]                  @relation("ProductCreator")
  createdOrders              Order[]                    @relation("OrderCreator")
  confirmedOrders            Order[]                    @relation("OrderConfirmer")
  dealerApplicationsReviewed DealerApplication[]        @relation("ApplicationReviewer")
  approvedDealers            Dealer[]                   @relation("DealerApprover")
  creditApprovals            DealerCreditProfile[]      @relation("CreditApprover")
  verifiedDocuments          DealerDocument[]           @relation("DocumentVerifier")
  createdThemes              SellerTheme[]              @relation("ThemeCreator")
  themeVersions              ThemeVersion[]             @relation("ThemeVersionCreator")
  createdProformas           ProformaInvoice[]          @relation("ProformaCreator")
  confirmedProformas         ProformaInvoice[]          @relation("ProformaConfirmer")
  proformaRevisions          ProformaInvoiceRevision[]  @relation("ProformaRevisionCreator")
  orderRevisions             OrderRevision[]            @relation("OrderRevisionCreator")
  orderRemarks               OrderRemark[]
  statusChanges              OrderStatusHistory[]       @relation("StatusChanger")
  dealerConfirmations        DealerConfirmation[]       @relation("ConfirmationUser")
  pickListAssignments        PickList[]                 @relation("PickListAssigner")
  pickListPickers            PickList[]                 @relation("PickListPicker")
  pickListCompleters         PickList[]                 @relation("PickListCompleter")
  pickExceptionReporters     PickListException[]        @relation("ExceptionReporter")
  pickExceptionResolvers     PickListException[]        @relation("ExceptionResolver")
  finalInvoiceGenerators     FinalInvoice[]             @relation("FinalInvoiceGenerator")
  payments                   Payment[]                  @relation("PaymentRecorder")
  paymentVerifiers           Payment[]                  @relation("PaymentVerifier")
  creditApprovalRecords      CreditApproval[]           @relation("CreditApprover2")
  packages                   Package[]
  shipments                  Shipment[]                 @relation("ShipmentCreator")
  deliveryUpdates            DeliveryEvent[]            @relation("DeliveryUpdater")
  inventoryTransactions      InventoryTransaction[]     @relation("InventoryPerformer")
  stockAdjustments           StockAdjustment[]          @relation("AdjustmentPerformer")
  pricesCreated              ProductPrice[]             @relation("PriceCreator")
  sellerCreated              Seller[]                   @relation("SellerCreator")
  featureOverrides           SellerFeature[]            @relation("FeatureOverrider")
  homepageSections           SellerHomepageSection[]
  userPreferences            UserAppearancePreference[]
  inquiryAssignments         Inquiry[]                  @relation("InquiryAssigner")
  inquiryFollowUps           InquiryFollowUp[]
  dealerEmployees            DealerEmployee[]

  @@index([email])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid()) @db.VarChar(50)
  userId            String  @db.VarChar(50)
  type              String
  provider          String  @db.VarChar(50)
  providerAccountId String  @db.VarChar(50)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid()) @db.VarChar(50)
  sessionToken String   @unique @db.VarChar(50)
  userId       String   @db.VarChar(50)
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  sellerId     String?  @db.VarChar(50)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String   @db.VarChar(50)
  token      String   @unique @db.VarChar(50)
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid()) @db.VarChar(50)
  userId    String    @db.VarChar(50)
  tokenHash String    @unique @db.VarChar(50)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TwoFactorToken {
  id                     String    @id @default(cuid()) @db.VarChar(50)
  userId                 String    @unique @db.VarChar(50)
  secretEncrypted        String    @db.Text
  recoveryCodesEncrypted String?   @db.Text
  verifiedAt             DateTime?
  createdAt              DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id        String   @id @default(cuid()) @db.VarChar(50)
  userId    String   @db.VarChar(50)
  ipAddress String?
  userAgent String?  @db.Text
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// PLATFORM & SELLER MODELS
// ============================================================

model Seller {
  id                 String       @id @default(cuid()) @db.VarChar(50)
  code               String       @unique @db.VarChar(50)
  slug               String       @unique @db.VarChar(50)
  legalName          String
  tradingName        String
  description        String?      @db.Text
  industry           String?
  email              String?
  phone              String?
  website            String?
  countryCode        String       @default("+977")
  country            String       @default("Nepal")
  province           String?
  district           String?
  city               String?
  addressLine1       String?
  addressLine2       String?
  postalCode         String?
  currencyCode       String       @default("NPR")
  timeZone           String       @default("Asia/Kathmandu")
  defaultLanguage    String       @default("en")
  taxNumber          String?
  registrationNumber String?
  status             SellerStatus @default(PENDING_SETUP)
  subscriptionPlanId String?      @db.VarChar(50)
  trialEndsAt        DateTime?
  activeFrom         DateTime?
  activeUntil        DateTime?
  createdById        String?      @db.VarChar(50)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  createdBy                User?                         @relation("SellerCreator", fields: [createdById], references: [id])
  subscriptionPlan         SubscriptionPlan?             @relation(fields: [subscriptionPlanId], references: [id])
  domains                  SellerDomain[]
  subscription             SellerSubscription?
  themes                   SellerTheme[]
  branches                 SellerBranch[]
  warehouses               Warehouse[]
  memberships              UserSellerMembership[]
  roles                    Role[]
  dealers                  Dealer[]
  dealerApplications       DealerApplication[]
  dealerGroups             DealerGroup[]
  pricingGroups            PricingGroup[]
  products                 Product[]
  categories               ProductCategory[]
  brands                   ProductBrand[]
  attributes               ProductAttribute[]
  orders                   Order[]
  proformaInvoices         ProformaInvoice[]
  finalInvoices            FinalInvoice[]
  pickLists                PickList[]
  payments                 Payment[]
  creditApprovals          CreditApproval[]
  packages                 Package[]
  shipments                Shipment[]
  inventories              Inventory[]
  inventoryTransactions    InventoryTransaction[]
  stockReservations        StockReservation[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  fileAssets               FileAsset[]
  features                 SellerFeature[]
  homepageSections         SellerHomepageSection[]
  userPreferences          UserAppearancePreference[]
  salespersonAssignments   SalespersonDealerAssignment[]
  dealerCreditProfiles     DealerCreditProfile[]
  dealerAddresses          DealerAddress[]
  dealerDocuments          DealerDocument[]
  dealerEmployees          DealerEmployee[]
  productImages            ProductImage[]
  productDocuments         ProductDocument[]
  productVariants          ProductVariant[]
  productAttributeValues   ProductAttributeValue[]
  productVariantAttributes ProductVariantAttribute[]
  productPrices            ProductPrice[]
  orderItems               OrderItem[]
  orderRevisions           OrderRevision[]
  orderRevisionItems       OrderRevisionItem[]
  orderRemarks             OrderRemark[]
  orderStatusHistories     OrderStatusHistory[]
  dealerConfirmations      DealerConfirmation[]
  proformaItems            ProformaInvoiceItem[]
  proformaRevisions        ProformaInvoiceRevision[]
  pickListItems            PickListItem[]
  pickListExceptions       PickListException[]
  finalInvoiceItems        FinalInvoiceItem[]
  stockAdjustments         StockAdjustment[]
  deliveryEvents           DeliveryEvent[]
  inquiries                Inquiry[]
  numberSequences          NumberSequence[]
  companyProfile           CompanyProfile?
  transportCompanies       TransportCompany[]
  transportDrivers         TransportDriver[]
  transportVehicles        TransportVehicle[]

  @@index([status])
  @@index([slug])
}

/// The single editable company record for this application. `Seller` remains an
/// internal ownership key for existing business records, but is never exposed as
/// a tenant or seller-management feature.
model CompanyProfile {
  id                 String   @id @default("bageshwari-tractors") @db.VarChar(50)
  sellerId           String   @unique @db.VarChar(50)
  companyName        String
  tradingName        String
  contactPerson      String?
  email              String?
  phone              String?
  website            String?
  country            String   @default("Nepal")
  province           String?
  district           String?
  city               String?
  address            String?
  panNumber          String?
  vatNumber          String?
  registrationNumber String?
  defaultVatPercent  Decimal  @default(13.00) @db.Decimal(5, 2)
  pricesIncludeVat   Boolean  @default(false)
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankBranch         String?
  bankSwiftCode      String?
  currencyCode       String   @default("NPR")
  timeZone           String   @default("Asia/Kathmandu")
  businessHours      String?
  footerText         String?  @db.Text
  terms              String?  @db.LongText
  privacyPolicy      String?  @db.LongText
  shippingPolicy     String?  @db.LongText
  returnPolicy       String?  @db.LongText
  socialLinksJson    String?  @db.Text
  logoUrl            String?
  compactLogoUrl     String?
  faviconUrl         String?
  emailLogoUrl       String?
  invoiceLogoUrl     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model SellerDomain {
  id                 String       @id @default(cuid()) @db.VarChar(50)
  sellerId           String       @db.VarChar(50)
  hostname           String       @unique @db.VarChar(100)
  isPrimary          Boolean      @default(false)
  verificationToken  String?
  verificationStatus DomainStatus @default(PENDING_VERIFICATION)
  verifiedAt         DateTime?
  sslStatus          String?      @default("pending")
  status             DomainStatus @default(PENDING_VERIFICATION)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model SellerSubscription {
  id           String             @id @default(cuid()) @db.VarChar(50)
  sellerId     String             @unique @db.VarChar(50)
  planId       String             @db.VarChar(50)
  status       SubscriptionStatus @default(PENDING)
  startDate    DateTime?
  endDate      DateTime?
  trialEndDate DateTime?
  billingCycle String?            @default("monthly")
  amount       Decimal            @db.Decimal(18, 2)
  currencyCode String             @default("NPR")
  autoRenew    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  seller Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([planId])
}

model SubscriptionPlan {
  id           String   @id @default(cuid()) @db.VarChar(50)
  name         String
  code         String   @unique @db.VarChar(50)
  description  String?  @db.Text
  monthlyPrice Decimal  @db.Decimal(18, 2)
  annualPrice  Decimal  @db.Decimal(18, 2)
  currencyCode String   @default("NPR")
  isActive     Boolean  @default(true)
  limitsJson   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  features      PlanFeature[]
  sellers       Seller[]
  subscriptions SellerSubscription[]
}

model PlanFeature {
  id         String  @id @default(cuid()) @db.VarChar(50)
  planId     String  @db.VarChar(50)
  featureKey String  @db.VarChar(50)
  enabled    Boolean @default(true)
  limitValue Int?

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model SellerFeature {
  id             String   @id @default(cuid()) @db.VarChar(50)
  sellerId       String   @db.VarChar(50)
  featureKey     String   @db.VarChar(50)
  enabled        Boolean  @default(true)
  limitValue     Int?
  overrideReason String?
  overriddenById String?  @db.VarChar(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  seller       Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  overriddenBy User?  @relation("FeatureOverrider", fields: [overriddenById], references: [id])

  @@unique([sellerId, featureKey])
}

model SellerBranch {
  id           String    @id @default(cuid()) @db.VarChar(50)
  sellerId     String    @db.VarChar(50)
  code         String    @db.VarChar(50)
  name         String
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  province     String?
  country      String    @default("Nepal")
  timeZone     String    @default("Asia/Kathmandu")
  isHeadOffice Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  seller      Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  warehouses  Warehouse[]
  memberships UserSellerMembership[]

  @@unique([sellerId, code])
  @@index([sellerId])
}

model Warehouse {
  id           String    @id @default(cuid()) @db.VarChar(50)
  sellerId     String    @db.VarChar(50)
  branchId     String?   @db.VarChar(50)
  code         String    @db.VarChar(50)
  name         String
  addressLine1 String?
  city         String?
  district     String?
  contactName  String?
  phone        String?
  email        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  seller                Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  branch                SellerBranch?          @relation(fields: [branchId], references: [id])
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  stockReservations     StockReservation[]
  stockAdjustments      StockAdjustment[]
  pickLists             PickList[]

  @@unique([sellerId, code])
  @@index([sellerId])
}

// ============================================================
// THEME MODELS
// ============================================================

model SellerTheme {
  id                 String      @id @default(cuid()) @db.VarChar(50)
  sellerId           String      @db.VarChar(50)
  name               String
  status             ThemeStatus @default(DRAFT)
  version            Int         @default(1)
  logoUrl            String?
  compactLogoUrl     String?
  darkLogoUrl        String?
  faviconUrl         String?
  emailLogoUrl       String?
  invoiceLogoUrl     String?
  loginLogoUrl       String?
  tokensJson         String?     @db.Text
  lightTokensJson    String?     @db.Text
  darkTokensJson     String?     @db.Text
  homepageLayoutJson String?     @db.Text
  publishedAt        DateTime?
  scheduledAt        DateTime?
  createdById        String?     @db.VarChar(50)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  seller    Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("ThemeCreator", fields: [createdById], references: [id])
  versions  ThemeVersion[]

  @@index([sellerId])
  @@index([sellerId, status])
}

model ThemeVersion {
  id            String   @id @default(cuid()) @db.VarChar(50)
  sellerThemeId String   @db.VarChar(50)
  version       Int
  tokensJson    String?  @db.Text
  layoutJson    String?  @db.Text
  createdById   String?  @db.VarChar(50)
  createdAt     DateTime @default(now())

  sellerTheme SellerTheme @relation(fields: [sellerThemeId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("ThemeVersionCreator", fields: [createdById], references: [id])

  @@index([sellerThemeId])
}

model UserAppearancePreference {
  id                 String       @id @default(cuid()) @db.VarChar(50)
  userId             String       @db.VarChar(50)
  sellerId           String?      @db.VarChar(50)
  appearance         Appearance   @default(SYSTEM)
  sidebarCollapsed   Boolean      @default(false)
  tableDensity       TableDensity @default(COMFORTABLE)
  accentPreset       String?
  language           String       @default("en")
  defaultWarehouseId String?      @db.VarChar(50)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller Seller? @relation(fields: [sellerId], references: [id])

  @@unique([userId, sellerId])
}

model SellerHomepageSection {
  id           String              @id @default(cuid()) @db.VarChar(50)
  sellerId     String              @db.VarChar(50)
  sectionType  HomepageSectionType
  title        String?
  subtitle     String?             @db.Text
  layout       String?             @default("default")
  contentJson  String?             @db.LongText
  displayOrder Int                 @default(0)
  enabled      Boolean             @default(true)
  audience     SectionAudience     @default(PUBLIC)
  bgStyle      String?
  imageUrl     String?
  ctaLabel     String?
  ctaLink      String?
  maxItems     Int?
  startsAt     DateTime?
  endsAt       DateTime?
  publishedAt  DateTime?
  createdById  String?             @db.VarChar(50)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  seller    Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id])

  @@index([sellerId])
  @@index([sellerId, sectionType])
}

// ============================================================
// AUTHORIZATION MODELS
// ============================================================

model Role {
  id          String    @id @default(cuid()) @db.VarChar(50)
  sellerId    String?   @db.VarChar(50)
  code        String    @db.VarChar(50)
  name        String
  description String?
  scope       RoleScope @default(SELLER)
  systemRole  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seller      Seller?          @relation(fields: [sellerId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([sellerId, code])
  @@index([scope])
}

model Permission {
  id          String  @id @default(cuid()) @db.VarChar(50)
  code        String  @unique @db.VarChar(50)
  name        String
  description String?
  module      String

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid()) @db.VarChar(50)
  roleId       String @db.VarChar(50)
  permissionId String @db.VarChar(50)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserSellerMembership {
  id        String   @id @default(cuid()) @db.VarChar(50)
  userId    String   @db.VarChar(50)
  sellerId  String   @db.VarChar(50)
  branchId  String?  @db.VarChar(50)
  dealerId  String?  @db.VarChar(50)
  status    String   @default("active")
  isDefault Boolean  @default(false)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller    Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  branch    SellerBranch? @relation(fields: [branchId], references: [id])
  dealer    Dealer?       @relation(fields: [dealerId], references: [id])
  userRoles UserRole[]

  @@unique([userId, sellerId])
  @@index([sellerId])
}

model UserRole {
  id           String   @id @default(cuid()) @db.VarChar(50)
  userId       String   @db.VarChar(50)
  sellerId     String?  @db.VarChar(50)
  roleId       String   @db.VarChar(50)
  membershipId String?  @db.VarChar(50)
  createdAt    DateTime @default(now())

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  membership UserSellerMembership? @relation(fields: [membershipId], references: [id])

  @@unique([userId, roleId, sellerId])
  @@index([userId])
  @@index([sellerId])
}

// ============================================================
// DEALER MODELS
// ============================================================

model Dealer {
  id                    String       @id @default(cuid()) @db.VarChar(50)
  sellerId              String       @db.VarChar(50)
  code                  String       @db.VarChar(50)
  legalName             String
  tradingName           String?
  contactName           String?
  email                 String?
  phone                 String?
  taxNumber             String?
  registrationNumber    String?
  dealerGroupId         String?      @db.VarChar(50)
  pricingGroupId        String?      @db.VarChar(50)
  assignedSalespersonId String?      @db.VarChar(50)
  status                DealerStatus @default(PENDING_APPROVAL)
  creditEligible        Boolean      @default(false)
  notes                 String?      @db.Text
  approvedAt            DateTime?
  approvedById          String?      @db.VarChar(50)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  seller                 Seller                        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dealerGroup            DealerGroup?                  @relation(fields: [dealerGroupId], references: [id])
  pricingGroup           PricingGroup?                 @relation(fields: [pricingGroupId], references: [id])
  approvedBy             User?                         @relation("DealerApprover", fields: [approvedById], references: [id])
  addresses              DealerAddress[]
  documents              DealerDocument[]
  employees              DealerEmployee[]
  creditProfile          DealerCreditProfile?
  orders                 Order[]
  memberships            UserSellerMembership[]
  salespersonAssignments SalespersonDealerAssignment[]
  confirmations          DealerConfirmation[]
  prices                 ProductPrice[]                @relation("DealerPrices")

  @@unique([sellerId, code])
  @@index([sellerId])
  @@index([sellerId, status])
}

model DealerApplication {
  id                   String                  @id @default(cuid()) @db.VarChar(50)
  sellerId             String                  @db.VarChar(50)
  businessName         String
  contactName          String
  email                String
  phone                String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  municipality         String?
  district             String?
  province             String?
  territory            String?
  country              String                  @default("Nepal")
  taxNumber            String?
  registrationNumber   String?
  productInterestsJson String?                 @db.Text
  monthlyOrderEstimate Decimal?                @db.Decimal(18, 2)
  creditRequested      Boolean                 @default(false)
  existingBusinessInfo String?                 @db.Text
  documentsJson        String?                 @db.Text
  remarks              String?                 @db.Text
  status               DealerApplicationStatus @default(SUBMITTED)
  reviewedById         String?                 @db.VarChar(50)
  reviewedAt           DateTime?
  rejectionReason      String?                 @db.Text
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  seller     Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([sellerId])
  @@index([sellerId, status])
}

model DealerEmployee {
  id          String   @id @default(cuid()) @db.VarChar(50)
  sellerId    String   @db.VarChar(50)
  dealerId    String   @db.VarChar(50)
  userId      String   @db.VarChar(50)
  designation String?
  isPrimary   Boolean  @default(false)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, dealerId, userId])
  @@index([sellerId])
}

model DealerAddress {
  id           String      @id @default(cuid()) @db.VarChar(50)
  sellerId     String      @db.VarChar(50)
  dealerId     String      @db.VarChar(50)
  type         AddressType @default(BOTH)
  label        String?
  contactName  String?
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String?
  district     String?
  province     String?
  postalCode   String?
  country      String      @default("Nepal")
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([sellerId, dealerId])
}

model DealerDocument {
  id             String    @id @default(cuid()) @db.VarChar(50)
  sellerId       String    @db.VarChar(50)
  dealerId       String    @db.VarChar(50)
  fileAssetId    String?   @db.VarChar(50)
  documentType   String
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  verifiedAt     DateTime?
  verifiedById   String?   @db.VarChar(50)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  seller     Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dealer     Dealer     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  verifiedBy User?      @relation("DocumentVerifier", fields: [verifiedById], references: [id])
  fileAsset  FileAsset? @relation(fields: [fileAssetId], references: [id])

  @@index([sellerId, dealerId])
}

model DealerGroup {
  id          String   @id @default(cuid()) @db.VarChar(50)
  sellerId    String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller  Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dealers Dealer[]
  prices  ProductPrice[] @relation("DealerGroupPrices")

  @@unique([sellerId, code])
  @@index([sellerId])
}

model PricingGroup {
  id          String   @id @default(cuid()) @db.VarChar(50)
  sellerId    String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  name        String
  description String?
  priority    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller  Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dealers Dealer[]
  prices  ProductPrice[] @relation("PricingGroupPrices")

  @@unique([sellerId, code])
  @@index([sellerId])
}

model DealerCreditProfile {
  id                 String    @id @default(cuid()) @db.VarChar(50)
  sellerId           String    @db.VarChar(50)
  dealerId           String    @unique @db.VarChar(50)
  creditEligible     Boolean   @default(false)
  creditLimit        Decimal   @default(0) @db.Decimal(18, 2)
  currentOutstanding Decimal   @default(0) @db.Decimal(18, 2)
  availableCredit    Decimal   @default(0) @db.Decimal(18, 2)
  creditPeriodDays   Int       @default(30)
  holdStatus         Boolean   @default(false)
  holdReason         String?
  approvedById       String?   @db.VarChar(50)
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  seller     Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dealer     Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("CreditApprover", fields: [approvedById], references: [id])

  @@index([sellerId])
}

model SalespersonDealerAssignment {
  id            String    @id @default(cuid()) @db.VarChar(50)
  sellerId      String    @db.VarChar(50)
  salespersonId String    @db.VarChar(50)
  dealerId      String    @db.VarChar(50)
  activeFrom    DateTime  @default(now())
  activeUntil   DateTime?
  isPrimary     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, salespersonId, dealerId])
  @@index([sellerId])
}

// ============================================================
// CATALOGUE MODELS
// ============================================================

model ProductCategory {
  id             String        @id @default(cuid()) @db.VarChar(50)
  sellerId       String        @db.VarChar(50)
  parentId       String?       @db.VarChar(50)
  name           String
  slug           String        @db.VarChar(50)
  code           String        @db.VarChar(50)
  description    String?       @db.Text
  imageUrl       String?
  displayOrder   Int           @default(0)
  taxPercent     Decimal?      @db.Decimal(5, 2)
  status         ProductStatus @default(ACTIVE)
  seoTitle       String?
  seoDescription String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  seller   Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryChildren")
  products Product[]

  @@unique([sellerId, slug])
  @@unique([sellerId, code])
  @@index([sellerId])
}

model ProductBrand {
  id          String        @id @default(cuid()) @db.VarChar(50)
  sellerId    String        @db.VarChar(50)
  name        String
  slug        String        @db.VarChar(50)
  description String?       @db.Text
  logoUrl     String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  seller   Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([sellerId, slug])
  @@index([sellerId])
}

model Product {
  id                   String        @id @default(cuid()) @db.VarChar(50)
  sellerId             String        @db.VarChar(50)
  categoryId           String?       @db.VarChar(50)
  brandId              String?       @db.VarChar(50)
  name                 String
  slug                 String        @db.VarChar(50)
  sku                  String        @db.VarChar(50)
  shortDescription     String?       @db.Text
  description          String?       @db.LongText
  status               ProductStatus @default(ACTIVE)
  publishStatus        PublishStatus @default(DRAFT)
  featured             Boolean       @default(false)
  newArrival           Boolean       @default(false)
  bestSeller           Boolean       @default(false)
  onOffer              Boolean       @default(false)
  minimumOrderQuantity Decimal       @default(1) @db.Decimal(18, 3)
  maximumOrderQuantity Decimal?      @db.Decimal(18, 3)
  quantityIncrement    Decimal       @default(1) @db.Decimal(18, 3)
  unitCode             String        @default("PCS")
  alternateUnit        String?
  taxPercent           Decimal?      @db.Decimal(5, 2)
  hsnCode              String?
  warrantyText         String?       @db.Text
  packagingText        String?
  shippingText         String?
  seoTitle             String?
  seoDescription       String?       @db.Text
  publishedAt          DateTime?
  createdById          String?       @db.VarChar(50)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  seller      Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    ProductCategory?  @relation(fields: [categoryId], references: [id])
  brand       ProductBrand?     @relation(fields: [brandId], references: [id])
  createdBy   User?             @relation("ProductCreator", fields: [createdById], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  documents   ProductDocument[]
  prices      ProductPrice[]
  inventories Inventory[]
  orderItems  OrderItem[]

  @@unique([sellerId, sku])
  @@unique([sellerId, slug])
  @@index([sellerId])
  @@index([sellerId, categoryId])
  @@index([sellerId, brandId])
  @@index([sellerId, status, publishStatus])
}

model ProductVariant {
  id                   String        @id @default(cuid()) @db.VarChar(50)
  sellerId             String        @db.VarChar(50)
  productId            String        @db.VarChar(50)
  name                 String
  sku                  String        @db.VarChar(50)
  barcode              String?
  status               ProductStatus @default(ACTIVE)
  mrp                  Decimal       @db.Decimal(18, 2)
  costPrice            Decimal?      @db.Decimal(18, 2)
  weight               Decimal?      @db.Decimal(10, 3)
  length               Decimal?      @db.Decimal(10, 2)
  width                Decimal?      @db.Decimal(10, 2)
  height               Decimal?      @db.Decimal(10, 2)
  minimumOrderQuantity Decimal?      @db.Decimal(18, 3)
  maximumOrderQuantity Decimal?      @db.Decimal(18, 3)
  quantityIncrement    Decimal?      @db.Decimal(18, 3)
  isDefault            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  seller                Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product               Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  images                ProductImage[]
  attributes            ProductVariantAttribute[]
  prices                ProductPrice[]            @relation("VariantPrices")
  inventories           Inventory[]
  orderItems            OrderItem[]
  stockReservations     StockReservation[]
  inventoryTransactions InventoryTransaction[]
  pickListItems         PickListItem[]
  documents             ProductDocument[]

  @@unique([sellerId, sku])
  @@index([sellerId])
  @@index([sellerId, productId])
}

model ProductImage {
  id           String   @id @default(cuid()) @db.VarChar(50)
  sellerId     String   @db.VarChar(50)
  productId    String   @db.VarChar(50)
  variantId    String?  @db.VarChar(50)
  fileAssetId  String?  @db.VarChar(50)
  url          String?
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  seller    Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  fileAsset FileAsset?      @relation(fields: [fileAssetId], references: [id])

  @@index([sellerId, productId])
}

model ProductDocument {
  id           String   @id @default(cuid()) @db.VarChar(50)
  sellerId     String   @db.VarChar(50)
  productId    String   @db.VarChar(50)
  variantId    String?  @db.VarChar(50)
  fileAssetId  String?  @db.VarChar(50)
  documentType String
  title        String?
  createdAt    DateTime @default(now())

  seller    Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  fileAsset FileAsset?      @relation(fields: [fileAssetId], references: [id])

  @@index([sellerId, productId])
}

model ProductAttribute {
  id              String   @id @default(cuid()) @db.VarChar(50)
  sellerId        String   @db.VarChar(50)
  name            String
  code            String   @db.VarChar(50)
  type            String   @default("text")
  filterable      Boolean  @default(false)
  variantDefining Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller            Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  values            ProductAttributeValue[]
  variantAttributes ProductVariantAttribute[]

  @@unique([sellerId, code])
  @@index([sellerId])
}

model ProductAttributeValue {
  id           String   @id @default(cuid()) @db.VarChar(50)
  sellerId     String   @db.VarChar(50)
  attributeId  String   @db.VarChar(50)
  value        String
  displayValue String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  seller            Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  attribute         ProductAttribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantAttributes ProductVariantAttribute[]

  @@index([sellerId, attributeId])
}

model ProductVariantAttribute {
  id               String @id @default(cuid()) @db.VarChar(50)
  sellerId         String @db.VarChar(50)
  variantId        String @db.VarChar(50)
  attributeId      String @db.VarChar(50)
  attributeValueId String @db.VarChar(50)

  seller         Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      ProductAttribute      @relation(fields: [attributeId], references: [id])
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([sellerId, variantId, attributeId])
  @@index([sellerId])
}

// ============================================================
// PRICING MODELS
// ============================================================

model ProductPrice {
  id              String    @id @default(cuid()) @db.VarChar(50)
  sellerId        String    @db.VarChar(50)
  productId       String    @db.VarChar(50)
  variantId       String?   @db.VarChar(50)
  priceType       PriceType
  dealerId        String?   @db.VarChar(50)
  dealerGroupId   String?   @db.VarChar(50)
  pricingGroupId  String?   @db.VarChar(50)
  amount          Decimal   @db.Decimal(18, 2)
  currencyCode    String    @default("NPR")
  minimumQuantity Decimal?  @db.Decimal(18, 3)
  maximumQuantity Decimal?  @db.Decimal(18, 3)
  validFrom       DateTime?
  validUntil      DateTime?
  priority        Int       @default(0)
  active          Boolean   @default(true)
  createdById     String?   @db.VarChar(50)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller       Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation("VariantPrices", fields: [variantId], references: [id])
  dealer       Dealer?         @relation("DealerPrices", fields: [dealerId], references: [id])
  dealerGroup  DealerGroup?    @relation("DealerGroupPrices", fields: [dealerGroupId], references: [id])
  pricingGroup PricingGroup?   @relation("PricingGroupPrices", fields: [pricingGroupId], references: [id])
  createdBy    User?           @relation("PriceCreator", fields: [createdById], references: [id])

  @@index([sellerId, variantId])
  @@index([sellerId, dealerId])
  @@index([sellerId, pricingGroupId])
  @@index([sellerId, productId])
}

// ============================================================
// INVENTORY MODELS
// ============================================================

model Inventory {
  id                String   @id @default(cuid()) @db.VarChar(50)
  sellerId          String   @db.VarChar(50)
  warehouseId       String   @db.VarChar(50)
  productId         String   @db.VarChar(50)
  variantId         String   @db.VarChar(50)
  availableQuantity Decimal  @default(0) @db.Decimal(18, 3)
  reservedQuantity  Decimal  @default(0) @db.Decimal(18, 3)
  pickedQuantity    Decimal  @default(0) @db.Decimal(18, 3)
  damagedQuantity   Decimal  @default(0) @db.Decimal(18, 3)
  inTransitQuantity Decimal  @default(0) @db.Decimal(18, 3)
  reorderLevel      Decimal  @default(0) @db.Decimal(18, 3)
  lowStockThreshold Decimal  @default(0) @db.Decimal(18, 3)
  binLocation       String?
  rackLocation      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seller    Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([sellerId, warehouseId, variantId])
  @@index([sellerId])
  @@index([sellerId, warehouseId])
}

model InventoryTransaction {
  id              String                   @id @default(cuid()) @db.VarChar(50)
  sellerId        String                   @db.VarChar(50)
  warehouseId     String                   @db.VarChar(50)
  productId       String                   @db.VarChar(50)
  variantId       String                   @db.VarChar(50)
  transactionType InventoryTransactionType
  quantity        Decimal                  @db.Decimal(18, 3)
  beforeQuantity  Decimal                  @db.Decimal(18, 3)
  afterQuantity   Decimal                  @db.Decimal(18, 3)
  referenceType   String?
  referenceId     String?                  @db.VarChar(50)
  reason          String?
  performedById   String?                  @db.VarChar(50)
  createdAt       DateTime                 @default(now())

  seller      Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  performedBy User?          @relation("InventoryPerformer", fields: [performedById], references: [id])

  @@index([sellerId])
  @@index([sellerId, warehouseId, variantId])
  @@index([createdAt])
}

model StockReservation {
  id          String                 @id @default(cuid()) @db.VarChar(50)
  sellerId    String                 @db.VarChar(50)
  warehouseId String                 @db.VarChar(50)
  orderId     String                 @db.VarChar(50)
