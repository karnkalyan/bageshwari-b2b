  requestedAmount  Decimal              @db.Decimal(18, 2)
  approvedAmount   Decimal?             @db.Decimal(18, 2)
  creditPeriodDays Int?
  dueDate          DateTime?
  remarks          String?              @db.Text
  approvedById     String?              @db.VarChar(50)
