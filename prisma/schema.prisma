  seller      Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order       Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  generatedBy User?                     @relation("ProformaCreator", fields: [generatedById], references: [id])
  confirmedBy User?                     @relation("ProformaConfirmer", fields: [confirmedById], references: [id])
  items       ProformaInvoiceItem[]
  revisions   ProformaInvoiceRevision[]

  @@unique([sellerId, proformaNumber])
  @@index([sellerId])
  @@index([sellerId, orderId])
}

model ProformaInvoiceItem {
  id                String  @id @default(cuid()) @db.VarChar(50)
  sellerId          String  @db.VarChar(50)
  proformaInvoiceId String  @db.VarChar(50)
  orderItemId       String? @db.VarChar(50)
  productId         String  @db.VarChar(50)
  variantId         String  @db.VarChar(50)
  sku               String  @db.VarChar(50)
  description       String?
  quantity          Decimal @db.Decimal(18, 3)
  unitPrice         Decimal @db.Decimal(18, 2)
  discountAmount    Decimal @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal @default(0) @db.Decimal(18, 2)
  lineTotal         Decimal @default(0) @db.Decimal(18, 2)

  seller   Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  proforma ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)

  @@index([sellerId, proformaInvoiceId])
}

model ProformaInvoiceRevision {
  id                String   @id @default(cuid()) @db.VarChar(50)
  sellerId          String   @db.VarChar(50)
  proformaInvoiceId String   @db.VarChar(50)
  version           Int
  snapshotJson      String?  @db.LongText
  reason            String?  @db.Text
  createdById       String?  @db.VarChar(50)
  createdAt         DateTime @default(now())

  seller    Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
