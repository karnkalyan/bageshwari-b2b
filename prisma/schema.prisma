// ============================================================
// ORDER MODELS
// ============================================================

model Order {
  id                    String      @id @default(cuid()) @db.VarChar(50)
  sellerId              String      @db.VarChar(50)
  orderNumber           String      @db.VarChar(50)
  dealerId              String      @db.VarChar(50)
  salespersonId         String?     @db.VarChar(50)
  source                OrderSource @default(DEALER_PORTAL)
  status                OrderStatus @default(DRAFT)
  currencyCode          String      @default("NPR")
  billingAddressJson    String?     @db.Text
  shippingAddressJson   String?     @db.Text
  purchaseOrderNumber   String?
  purchaseOrderDocUrl   String?
  requestedDeliveryDate DateTime?
  subtotal              Decimal     @default(0) @db.Decimal(18, 2)
  discountTotal         Decimal     @default(0) @db.Decimal(18, 2)
  taxTotal              Decimal     @default(0) @db.Decimal(18, 2)
  freightTotal          Decimal     @default(0) @db.Decimal(18, 2)
  additionalChargeTotal Decimal     @default(0) @db.Decimal(18, 2)
  grandTotal            Decimal     @default(0) @db.Decimal(18, 2)
  dealerNotes           String?     @db.Text
  salespersonNotes      String?     @db.Text
  accountsNotes         String?     @db.Text
  currentDepartment     String?
  submittedAt           DateTime?
  finalConfirmedAt      DateTime?
  finalConfirmedById    String?     @db.VarChar(50)
  lockedAt              DateTime?
  createdById           String?     @db.VarChar(50)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  seller            Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dealer            Dealer               @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  createdBy         User?                @relation("OrderCreator", fields: [createdById], references: [id])
  finalConfirmedBy  User?                @relation("OrderConfirmer", fields: [finalConfirmedById], references: [id])
  items             OrderItem[]
  revisions         OrderRevision[]
  remarks           OrderRemark[]
  statusHistory     OrderStatusHistory[]
  confirmations     DealerConfirmation[]
  proformaInvoices  ProformaInvoice[]
  pickLists         PickList[]
  finalInvoices     FinalInvoice[]
  payments          Payment[]
  creditApprovals   CreditApproval[]
  packages          Package[]
  shipments         Shipment[]
  stockReservations StockReservation[]

  @@unique([sellerId, orderNumber])
  @@index([sellerId])
  @@index([sellerId, dealerId])
  @@index([sellerId, status])
  @@index([sellerId, createdAt])
}

model OrderItem {
  id               String          @id @default(cuid()) @db.VarChar(50)
  sellerId         String          @db.VarChar(50)
  orderId          String          @db.VarChar(50)
  productId        String          @db.VarChar(50)
  variantId        String          @db.VarChar(50)
  sku              String          @db.VarChar(50)
  productName      String
  variantName      String?
  originalQuantity Decimal         @db.Decimal(18, 3)
  approvedQuantity Decimal?        @db.Decimal(18, 3)
  pickedQuantity   Decimal?        @db.Decimal(18, 3)
  mrp              Decimal         @db.Decimal(18, 2)
  dealerPrice      Decimal         @db.Decimal(18, 2)
  discountAmount   Decimal         @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal         @default(0) @db.Decimal(18, 2)
  status           OrderItemStatus @default(ACTIVE)
  dealerNotes      String?
  accountsRemarks  String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  seller            Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  revisionItems     OrderRevisionItem[]
  stockReservations StockReservation[]

  @@index([sellerId, orderId])
}

model OrderRevision {
  id                 String              @id @default(cuid()) @db.VarChar(50)
  sellerId           String              @db.VarChar(50)
  orderId            String              @db.VarChar(50)
  version            Int
  status             OrderRevisionStatus @default(PENDING)
  previousSubtotal   Decimal?            @db.Decimal(18, 2)
  revisedSubtotal    Decimal?            @db.Decimal(18, 2)
  previousGrandTotal Decimal?            @db.Decimal(18, 2)
  revisedGrandTotal  Decimal?            @db.Decimal(18, 2)
  generalRemarks     String?             @db.Text
  createdById        String?             @db.VarChar(50)
  sentToDealerAt     DateTime?
  dealerRespondedAt  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  seller       Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("OrderRevisionCreator", fields: [createdById], references: [id])
  items        OrderRevisionItem[]
  confirmation DealerConfirmation[]

  @@index([sellerId, orderId])
}

model OrderRevisionItem {
  id               String   @id @default(cuid()) @db.VarChar(50)
  sellerId         String   @db.VarChar(50)
  orderRevisionId  String   @db.VarChar(50)
  orderItemId      String   @db.VarChar(50)
  previousQuantity Decimal? @db.Decimal(18, 3)
  revisedQuantity  Decimal? @db.Decimal(18, 3)
  previousPrice    Decimal? @db.Decimal(18, 2)
  revisedPrice     Decimal? @db.Decimal(18, 2)
  changeType       String
  reason           String?  @db.Text

  seller    Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  revision  OrderRevision @relation(fields: [orderRevisionId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([sellerId, orderRevisionId])
}

model OrderRemark {
  id           String   @id @default(cuid()) @db.VarChar(50)
  sellerId     String   @db.VarChar(50)
  orderId      String   @db.VarChar(50)
  orderItemId  String?  @db.VarChar(50)
  userId       String   @db.VarChar(50)
  department   String?
  message      String   @db.Text
  internalOnly Boolean  @default(false)
  createdAt    DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([sellerId, orderId])
}

model OrderStatusHistory {
  id           String       @id @default(cuid()) @db.VarChar(50)
  sellerId     String       @db.VarChar(50)
  orderId      String       @db.VarChar(50)
  fromStatus   OrderStatus?
  toStatus     OrderStatus
  changedById  String?      @db.VarChar(50)
  remarks      String?      @db.Text
  metadataJson String?      @db.Text
  createdAt    DateTime     @default(now())

  seller    Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User?  @relation("StatusChanger", fields: [changedById], references: [id])

  @@index([sellerId, orderId])
  @@index([createdAt])
}

model DealerConfirmation {
  id            String         @id @default(cuid()) @db.VarChar(50)
  sellerId      String         @db.VarChar(50)
  orderId       String         @db.VarChar(50)
  revisionId    String?        @db.VarChar(50)
  dealerId      String         @db.VarChar(50)
  decision      DealerDecision
  remarks       String?        @db.Text
  confirmedById String?        @db.VarChar(50)
  confirmedAt   DateTime       @default(now())
  ipAddress     String?

  seller      Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revision    OrderRevision? @relation(fields: [revisionId], references: [id])
  dealer      Dealer         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  confirmedBy User?          @relation("ConfirmationUser", fields: [confirmedById], references: [id])

  @@index([sellerId, orderId])
}

// ============================================================
// PROFORMA INVOICE MODELS
