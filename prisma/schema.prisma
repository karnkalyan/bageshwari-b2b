// ============================================================
// Bageshwari B2B Multi-Vendor Commerce Platform
// Prisma Schema — MySQL (utf8mb4 safe 1000-byte key compatible)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
  PENDING_VERIFICATION
}

enum SellerStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  ARCHIVED
  PENDING_SETUP
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
  EXPIRED
  PENDING
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  SUSPENDED
  ACTIVE
}

enum ThemeStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum DealerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
