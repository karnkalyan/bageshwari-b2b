model ProformaInvoice {
  id             String         @id @default(cuid()) @db.VarChar(50)
  sellerId       String         @db.VarChar(50)
  orderId        String         @db.VarChar(50)
  proformaNumber String         @db.VarChar(50)
  version        Int            @default(1)
  status         ProformaStatus @default(DRAFT)
  issueDate      DateTime       @default(now())
  validUntil     DateTime?
  subtotal       Decimal        @default(0) @db.Decimal(18, 2)
  discountTotal  Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal       Decimal        @default(0) @db.Decimal(18, 2)
  freightTotal   Decimal        @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal        @default(0) @db.Decimal(18, 2)
  paymentTerms   String?        @db.Text
  creditTerms    String?        @db.Text
  remarks        String?        @db.Text
  generatedById  String?        @db.VarChar(50)
  confirmedById  String?        @db.VarChar(50)
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
