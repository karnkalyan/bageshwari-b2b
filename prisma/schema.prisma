// PICK LIST MODELS
// ============================================================

model PickList {
  id             String         @id @default(cuid()) @db.VarChar(50)
  sellerId       String         @db.VarChar(50)
  orderId        String         @db.VarChar(50)
  warehouseId    String         @db.VarChar(50)
  pickListNumber String         @db.VarChar(50)
  status         PickListStatus @default(GENERATED)
  assignedToId   String?        @db.VarChar(50)
  pickerId       String?        @db.VarChar(50)
  startedAt      DateTime?
  completedAt    DateTime?
  completedById  String?        @db.VarChar(50)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  seller      Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  assignedTo  User?               @relation("PickListAssigner", fields: [assignedToId], references: [id])
  picker      User?               @relation("PickListPicker", fields: [pickerId], references: [id])
  completedBy User?               @relation("PickListCompleter", fields: [completedById], references: [id])
  items       PickListItem[]
  exceptions  PickListException[]

  @@unique([sellerId, pickListNumber])
  @@index([sellerId])
  @@index([sellerId, orderId])
  @@index([sellerId, status])
}

model PickListItem {
  id               String   @id @default(cuid()) @db.VarChar(50)
  sellerId         String   @db.VarChar(50)
  pickListId       String   @db.VarChar(50)
  productId        String   @db.VarChar(50)
  variantId        String   @db.VarChar(50)
  sku              String   @db.VarChar(50)
  rackLocation     String?
  binLocation      String?
  approvedQuantity Decimal  @db.Decimal(18, 3)
  pickedQuantity   Decimal  @default(0) @db.Decimal(18, 3)
  batchNumber      String?
  serialNumber     String?
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seller   Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  pickList PickList       @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([sellerId, pickListId])
}

model PickListException {
  id           String                 @id @default(cuid()) @db.VarChar(50)
  sellerId     String                 @db.VarChar(50)
  pickListId   String                 @db.VarChar(50)
  variantId    String                 @db.VarChar(50)
  expectedQty  Decimal                @db.Decimal(18, 3)
  availableQty Decimal                @db.Decimal(18, 3)
  shortageQty  Decimal                @db.Decimal(18, 3)
  reason       String                 @db.Text
  status       PickingExceptionStatus @default(REPORTED)
  reportedById String?                @db.VarChar(50)
  resolvedById String?                @db.VarChar(50)
  resolvedAt   DateTime?
  resolution   String?                @db.Text
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  pickList   PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  reportedBy User?    @relation("ExceptionReporter", fields: [reportedById], references: [id])
  resolvedBy User?    @relation("ExceptionResolver", fields: [resolvedById], references: [id])

  @@index([sellerId, pickListId])
}

// ============================================================
// FINAL INVOICE MODELS
// ============================================================

model FinalInvoice {
  id                String             @id @default(cuid()) @db.VarChar(50)
  sellerId          String             @db.VarChar(50)
  orderId           String             @db.VarChar(50)
  invoiceNumber     String             @db.VarChar(50)
  status            FinalInvoiceStatus @default(DRAFT)
  issueDate         DateTime           @default(now())
  dueDate           DateTime?
  subtotal          Decimal            @default(0) @db.Decimal(18, 2)
  discountTotal     Decimal            @default(0) @db.Decimal(18, 2)
  taxTotal          Decimal            @default(0) @db.Decimal(18, 2)
  freightTotal      Decimal            @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal            @default(0) @db.Decimal(18, 2)
  paidAmount        Decimal            @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal            @default(0) @db.Decimal(18, 2)
  paymentTerms      String?            @db.Text
  remarks           String?            @db.Text
  generatedById     String?            @db.VarChar(50)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  seller      Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  generatedBy User?              @relation("FinalInvoiceGenerator", fields: [generatedById], references: [id])
  items       FinalInvoiceItem[]
  payments    Payment[]
  shipments   Shipment[]

  @@unique([sellerId, invoiceNumber])
  @@index([sellerId])
  @@index([sellerId, orderId])
  @@index([sellerId, status])
}

model FinalInvoiceItem {
  id             String  @id @default(cuid()) @db.VarChar(50)
  sellerId       String  @db.VarChar(50)
  finalInvoiceId String  @db.VarChar(50)
  orderItemId    String? @db.VarChar(50)
  productId      String  @db.VarChar(50)
  variantId      String  @db.VarChar(50)
  sku            String  @db.VarChar(50)
  description    String?
  quantity       Decimal @db.Decimal(18, 3)
  unitPrice      Decimal @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal @default(0) @db.Decimal(18, 2)

  seller  Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  invoice FinalInvoice @relation(fields: [finalInvoiceId], references: [id], onDelete: Cascade)

  @@index([sellerId, finalInvoiceId])
}

// ============================================================
// PAYMENT MODELS
// ============================================================

model Payment {
  id             String        @id @default(cuid()) @db.VarChar(50)
  sellerId       String        @db.VarChar(50)
  orderId        String        @db.VarChar(50)
  finalInvoiceId String?       @db.VarChar(50)
  paymentNumber  String        @db.VarChar(50)
  method         PaymentMethod
