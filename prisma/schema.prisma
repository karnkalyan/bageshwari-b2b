  dispatchDocUrl     String?
  remarks            String?        @db.Text
  createdById        String?        @db.VarChar(50)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  seller           Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  finalInvoice     FinalInvoice?     @relation(fields: [finalInvoiceId], references: [id])
  createdBy        User?             @relation("ShipmentCreator", fields: [createdById], references: [id])
  transportCompany TransportCompany? @relation(fields: [transportCompanyId], references: [id])
  driver           TransportDriver?  @relation(fields: [driverId], references: [id])
  vehicle          TransportVehicle? @relation(fields: [vehicleId], references: [id])
  packages         Package[]
  events           DeliveryEvent[]

  @@unique([sellerId, shipmentNumber])
  @@index([sellerId])
  @@index([sellerId, orderId])
  @@index([transportCompanyId])
}

model TransportCompany {
  id          String   @id @default(cuid()) @db.VarChar(50)
  sellerId    String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  panNumber   String?
  vatNumber   String?
  status      String   @default("ACTIVE")
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller    Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  drivers   TransportDriver[]
  vehicles  TransportVehicle[]
  shipments Shipment[]

  @@unique([sellerId, code])
  @@index([sellerId, status])
}

model TransportDriver {
  id                 String   @id @default(cuid()) @db.VarChar(50)
  sellerId           String   @db.VarChar(50)
  transportCompanyId String   @db.VarChar(50)
  name               String
  phone              String?
  licenseNumber      String?
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  seller           Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transportCompany TransportCompany   @relation(fields: [transportCompanyId], references: [id], onDelete: Cascade)
  vehicles         TransportVehicle[]
  shipments        Shipment[]

  @@index([sellerId, transportCompanyId])
}

model TransportVehicle {
  id                 String   @id @default(cuid()) @db.VarChar(50)
  sellerId           String   @db.VarChar(50)
  transportCompanyId String   @db.VarChar(50)
  driverId           String?  @db.VarChar(50)
  vehicleNumber      String   @db.VarChar(50)
  vehicleType        String?
  capacity           Decimal? @db.Decimal(12, 3)
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  seller           Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transportCompany TransportCompany @relation(fields: [transportCompanyId], references: [id], onDelete: Cascade)
  driver           TransportDriver? @relation(fields: [driverId], references: [id])
  shipments        Shipment[]

  @@unique([sellerId, vehicleNumber])
  @@index([sellerId, transportCompanyId])
}

model DeliveryEvent {
  id          String         @id @default(cuid()) @db.VarChar(50)
  sellerId    String         @db.VarChar(50)
  shipmentId  String         @db.VarChar(50)
  status      DeliveryStatus
  location    String?
  description String?        @db.Text
  proofUrl    String?
  updatedById String?        @db.VarChar(50)
  createdAt   DateTime       @default(now())

  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("DeliveryUpdater", fields: [updatedById], references: [id])

  @@index([sellerId, shipmentId])
}

// ============================================================
// INQUIRY MODEL
// ============================================================

model Inquiry {
  id                 String   @id @default(cuid()) @db.VarChar(50)
  sellerId           String   @db.VarChar(50)
  contactName        String
  email              String
  phone              String?
  companyName        String?
  location           String?
  message            String?  @db.Text
  productsJson       String?  @db.Text
  status             String   @default("submitted")
  assignedToId       String?  @db.VarChar(50)
  convertedToOrderId String?  @db.VarChar(50)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  seller     Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  assignedTo User?             @relation("InquiryAssigner", fields: [assignedToId], references: [id])
  followUps  InquiryFollowUp[]

  @@index([sellerId])
}

model InquiryFollowUp {
  id        String   @id @default(cuid()) @db.VarChar(50)
  inquiryId String   @db.VarChar(50)
  userId    String   @db.VarChar(50)
  message   String   @db.Text
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

// ============================================================
// NOTIFICATION MODEL
// ============================================================

model Notification {
  id        String              @id @default(cuid()) @db.VarChar(50)
  sellerId  String?             @db.VarChar(50)
  userId    String              @db.VarChar(50)
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(PENDING)
  title     String
  message   String              @db.Text
  linkUrl   String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  seller Seller? @relation(fields: [sellerId], references: [id])
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([sellerId])
}

// ============================================================
// FILE ASSET MODEL
// ============================================================

model FileAsset {
  id           String         @id @default(cuid()) @db.VarChar(50)
  sellerId     String?        @db.VarChar(50)
  fileName     String
  fileSize     Int?
  mimeType     String?
  storageKey   String
  url          String?
  visibility   FileVisibility @default(PRIVATE)
  uploadedById String?        @db.VarChar(50)
  createdAt    DateTime       @default(now())

  seller          Seller?           @relation(fields: [sellerId], references: [id])
  images          ProductImage[]
  documents       ProductDocument[]
  dealerDocuments DealerDocument[]

  @@index([sellerId])
}

// ============================================================
// AUDIT LOG MODEL
// ============================================================

model AuditLog {
  id        String        @id @default(cuid()) @db.VarChar(50)
  sellerId  String?       @db.VarChar(50)
  userId    String?       @db.VarChar(50)
  action    String
  entity    String
  entityId  String?       @db.VarChar(50)
  severity  AuditSeverity @default(LOW)
  oldValue  String?       @db.LongText
  newValue  String?       @db.LongText
  ipAddress String?
  userAgent String?
  metadata  String?       @db.Text
  createdAt DateTime      @default(now())

  seller Seller? @relation(fields: [sellerId], references: [id])
  user   User?   @relation("AuditUser", fields: [userId], references: [id])

  @@index([sellerId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================================
// NUMBER SEQUENCE MODEL
// ============================================================

model NumberSequence {
  id         String   @id @default(cuid()) @db.VarChar(50)
  sellerId   String   @db.VarChar(50)
  entityType String   @db.VarChar(50)
  prefix     String
  lastNumber Int      @default(0)
  padLength  Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, entityType])
}
