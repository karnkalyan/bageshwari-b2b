  PICKING_EXCEPTION
  PICK_LIST_COMPLETED
  FINAL_INVOICE_ISSUED
  PAYMENT_PENDING
  PARTIALLY_PAID
  PAID
  CREDIT_PENDING
  CREDIT_APPROVED
  PAYMENT_ON_HOLD
  PAYMENT_OVERDUE
  PACKING_IN_PROGRESS
  PACKED
  PACKED_AND_LABELLED
  SHIPPED
  IN_TRANSIT
  PARTIALLY_DELIVERED
