# Public listener (bind to loopback when a host reverse proxy terminates TLS)
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# MySQL connection metadata; the password is supplied through a Docker secret
DATABASE_HOST=host.docker.internal
DATABASE_PORT=3306
DATABASE_USER=bageshwari_app
DATABASE_NAME=bageshwari_b2b
DATABASE_PASSWORD_FILE=./secrets/database_password.txt

# Auth.js canonical public URL and secret files
AUTH_URL=https://b2b.example.com
AUTH_SECRET_FILE=./secrets/auth_secret.txt
SEED_PASSWORD_FILE=./secrets/seed_password.txt
